{
  "manifest_version": 2,
  "name": "Inbox Zero Thunderbird Bridge",
  "version": "0.2.2",
  "description": "Account-scoped mail reads, classification folders, and draft persistence.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-reader@inboxzero.local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "http://127.0.0.1/*",
    "storage",
    "accountsFolders",
    "messagesMove",
    "messagesUpdate",
    "compose",
    "compose.save"
  ],
  "background": {
    "scripts": [
      "protocol.js",
      "reader.js",
      "ledger.js",
      "bounded-read.js",
      "background.js"
    ],
    "persistent": true
  }
}
