{
  "manifest_version": 2,
  "name": "Inbox Zero Thunderbird Reader",
  "version": "0.1.3",
  "description": "Read-only, account-scoped connection to a local Inbox Zero bridge.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-reader@inboxzero.local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "reader.js",
      "bounded-read.js",
      "background.js"
    ],
    "persistent": true
  }
}
